# Local LLM via Ollama (free, no API key). Run `ollama pull llama3.2` first.

# OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Wake word bundled with openwakeword: hey_jarvis, alexa, hey_mycroft
WAKE_WORD=hey_jarvis

# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
TTS_VOICE=en-US-AndrewNeural

# --- voice tuning (defaults shown) ---
# Silence (s) that ends your utterance. Lower = snappier, but may cut you off.
# SILENCE_DURATION=0.8
# Speech threshold = NOISE_MULTIPLIER x measured room noise, never below MIN_SPEECH_RMS.
# MIN_SPEECH_RMS=300
# NOISE_MULTIPLIER=3.0
# Cut the first spoken chunk at a comma after this many characters (0 = whole sentences only).
# FIRST_CHUNK_MIN_CHARS=40
# Barge-in (--barge-in): mic level and duration that count as an interruption.
# BARGE_IN_RMS=1500
# BARGE_IN_SUSTAIN_SECONDS=0.4
# SHOW_TIMINGS=true