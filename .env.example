# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here
# Model to use
CLAUDE_MODEL=claude-sonnet-4-6

# Wake word model bundled with openwakeword: hey_jarvis, alexa, hey_mycroft
WAKE_WORD=hey_jarvis

# faster-whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base

# edge-tts voice: run `edge-tts --list-voices` for options
TTS_VOICE=en-US-AndrewNeural
